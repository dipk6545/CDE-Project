# ==============================================================================
# MBTA TRANSIT LAKEHOUSE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# Copy this file to '.env' and fill in your actual credentials.
# Note: NEVER commit the active '.env' file containing real secrets to git.

# ------------------------------------------------------------------------------
# 1. AWS S3 Storage Credentials (Sydney ap-southeast-2)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=ap-southeast-2
S3_BUCKET_NAME=cde-transit-lakehouse-221950623036-ap-southeast-2

# ------------------------------------------------------------------------------
# 2. MBTA API v3 (Optional: Higher rate limit with API key, default public access)
# ------------------------------------------------------------------------------
MBTA_API_KEY=

# ------------------------------------------------------------------------------
# 3. PostgreSQL Serving Layer (Prisma Cloud Serverless Postgres / Local Postgres)
# ------------------------------------------------------------------------------
POSTGRES_HOST=db.prisma.io
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SSLMODE=require

# ------------------------------------------------------------------------------
# 4. Apache Kafka Broker
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=mbta_vehicle_positions

# ------------------------------------------------------------------------------
# 5. Apache Airflow Webserver
# ------------------------------------------------------------------------------
AIRFLOW__CORE__LOAD_EXAMPLES=False
